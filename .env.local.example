# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase (Settings → API)
# ถ้ายังไม่ใส่ เว็บจะรันได้โดยใช้ข้อมูลตัวอย่าง (seed) อัตโนมัติ

# ใช้ฝั่ง client + server (public)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้เฉพาะฝั่ง server (ห้ามเปิดเผย / ใช้ในหลังบ้านสำหรับเขียนข้อมูล)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# โดเมนจริงของเว็บ (ใช้กับ SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://doensai.fc
